# ==============================================================================
# CEFR English Learning Platform - Environment Configuration Blueprint
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC / CLIENT-SIDE CREDENTIALS (VITE_*)
# Safe for browser exposure. Handled by React + Vite frontend.
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY / BACKEND CREDENTIALS (NEVER EXPOSE TO CLIENT)
# Used exclusively by Vercel Serverless Functions.
# CRITICAL: DO NOT prefix with VITE_ to prevent Vite bundling into client build.
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Supavisor Transaction Pooler (Port 6543, pool_mode=transaction)
SUPABASE_DB_URL=postgresql://postgres.your-project-id:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# ------------------------------------------------------------------------------
# 3. RUNTIME SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=development
API_BASE_URL=http://localhost:3000
