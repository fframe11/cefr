{
  "name": "cefr-english-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run tests/security-guard.test.ts tests/demo-exam-isolation.test.ts tests/mock-exam-ui.test.ts tests/serverless-api.test.ts tests/schema-migration.test.ts tests/glova-components.test.tsx tests/campaign-banner.test.tsx tests/glova-design-system.test.ts tests/diagnostic.test.ts tests/backend-foundation.test.ts tests/i18n.test.ts",
    "typecheck": "tsc --noEmit",
    "build:worker": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion",
    "preview:worker": "opennextjs-cloudflare preview",
    "test:load": "node scripts/load-test.mjs",
    "content:vocab:fetch": "node scripts/content-pipeline/vocab/fetch-sources.mjs",
    "content:vocab:validate": "node scripts/content-pipeline/vocab/pipeline.mjs validate",
    "content:vocab:normalize": "node scripts/content-pipeline/vocab/pipeline.mjs normalize",
    "content:vocab:report": "node scripts/content-pipeline/vocab/pipeline.mjs report",
    "vocabulary:ingest": "node scripts/content-pipeline/vocab/pipeline.mjs all",
    "vocabulary:enrich": "node scripts/content-pipeline/vocab/enrich-pipeline.mjs enrich",
    "vocabulary:qa": "node scripts/content-pipeline/vocab/enrich-pipeline.mjs qa",
    "vocabulary:report": "node scripts/content-pipeline/vocab/enrich-pipeline.mjs report",
    "vocabulary:large": "node scripts/content-pipeline/vocab/large-production-pipeline.mjs",
    "qa:integrity": "node scripts/content-pipeline/vocab/qa-integrity-check.mjs",
    "dev:speaking": "python -m uvicorn services.pronunciation.app:app --host 127.0.0.1 --port 8000"
  },
  "dependencies": {
    "@remotion/player": "4.0.529",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.4",
    "lottie-web": "^5.13.0",
    "lucide-react": "^0.475.0",
    "next": "^15.5.26",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.529",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "wrangler": "^4.140.0"
  }
}