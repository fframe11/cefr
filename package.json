{
  "name": "cefr-speaking-lab",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"next,inference\" -c \"blue,green\" \"next dev\" \"python -m uvicorn services.pronunciation.app:app --host 127.0.0.1 --port 8000\"",
    "dev:frontend": "next dev",
    "dev:inference": "python -m uvicorn services.pronunciation.app:app --host 127.0.0.1 --port 8000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.16.0",
    "next": "15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
